# -----------------------------------------------------------------------
# Philips Home Access – SmartThings Schema Connector
# Copy this file to ".env" and fill in your values before running.
# -----------------------------------------------------------------------

# ---- SmartThings Developer Workspace values ----------------------------
# Found in your connector's settings after registering at:
# https://developer.smartthings.com/

# The Client ID SmartThings will send when calling your token endpoint.
ST_CLIENT_ID=your-smartthings-client-id

# The Client Secret SmartThings will send when calling your token endpoint.
ST_CLIENT_SECRET=your-smartthings-client-secret

# ---- Flask / server settings ------------------------------------------

# A long random string used to sign Flask session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# TCP port the app listens on (default: 5000).
PORT=5000

# Set to "1" to enable verbose debug logging.
# DEBUG=1

# ---- Token storage -----------------------------------------------------
# Directory where token JSON files are written.
# Make sure this path is writable by the process.
DATA_DIR=.
